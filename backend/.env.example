# --- Core Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Optional dedicated key for encrypting provider API keys at rest. Keep stable.
# INTRADOC_ENCRYPTION_KEY=

# Optional managed Postgres. Leave blank for local SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Set to False after the initial Admin account exists.
ALLOW_FIRST_USER_BOOTSTRAP=True

# --- LLM providers (at least one) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT=120

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Redis / semantic cache ---
# Redis Stack (RediSearch) is required for the semantic cache.
INTRADOC_REDIS_URL=redis://localhost:6379/0

# --- Uploads ---
INTRADOC_MAX_UPLOAD_MB=25
INTRADOC_MAX_BATCH_MB=100
# INTRADOC_UPLOADS_DIR=/absolute/path/to/uploads

# --- Email (invites + password reset OTP) ---
# Local SMTP. Render's free tier blocks outbound SMTP ports, so production
# should use Brevo or Resend below instead.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Production HTTPS email APIs (work on Render free; set only one key)
# BREVO_API_KEY=
# RESEND_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# --- Production security ---
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
# AUTH_THROTTLE_RATE=10/min
